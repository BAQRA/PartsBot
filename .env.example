# Copy this file to .env and fill in the values.

# Google Gemini API key — required for the AI brain.
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Facebook/Instagram Messenger webhook (src/messenger.js) ──────────────────
# A secret string you choose. Enter the SAME value in the Meta App Dashboard
# when subscribing the webhook; Meta echoes it back on GET /webhook verification.
VERIFY_TOKEN=

# Page access token for the connected Facebook Page. Used to call the Send API.
# Meta App Dashboard → Messenger → Settings → Generate token for your Page.
PAGE_ACCESS_TOKEN=

# Your Meta app's App Secret. Used to verify the X-Hub-Signature-256 header on
# incoming POST /webhook requests. Meta App Dashboard → Settings → Basic.
APP_SECRET=

# ── Telegram lead notifications (src/notify.js) ──────────────────────────────
# When the bot captures a lead it can't fully resolve, it pushes a notification
# to Telegram so a human can follow up.
# Bot token from @BotFather (https://t.me/BotFather).
TELEGRAM_BOT_TOKEN=
# Chat/group id the leads are posted to (see README for how to find it).
TELEGRAM_CHAT_ID=
